# EYES OF VICTORY — environment configuration
# Copy to .env or set the variables in your hosting platform (Vercel:
# Project → Settings → Environment Variables). NEVER commit real values.

# REQUIRED on Vercel / production. Generate with:  openssl rand -hex 32
# The server FAILS CLOSED (boot error SESSION_SECRET_REQUIRED) when this is
# missing on serverless/production. Local development falls back to a random
# per-boot secret (sessions reset on restart).
SESSION_SECRET=

# Optional
# PORT=3000
# NODE_ENV=production
